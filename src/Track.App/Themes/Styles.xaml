<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="Sans">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- One font everywhere (user, 2026-11-19): numbers use tabular digits instead of a monospace font. -->
    <Style x:Key="Small" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>

    <!-- Was the monospace style for figures; same size as Small so sans figures stay readable. -->
    <Style x:Key="SmallNumbers" TargetType="TextBlock" BasedOn="{StaticResource Small}" />

    <!-- Rounded accent ring, shown only when focus arrives from the keyboard. -->
    <Style x:Key="KeyboardFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="5" BorderThickness="1.5" BorderBrush="{DynamicResource Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented Today / Week / Month control. -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- WPF shows a FocusVisualStyle only after keyboard navigation, so opening the popover does not
             make an unselected tab look selected. -->
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SegSelected}" />
                            <Setter TargetName="Bg" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.15" Direction="270" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text-only button, like the mockup's "Refresh". -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="Transparent" Padding="2,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="B" Property="BorderThickness" Value="0,0,0,1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A plain glyph button (the popover gear): no box, grey until hovered, keyboard ring only from the keyboard. -->
    <Style x:Key="HeaderIconButton" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RowBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Line}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A hoverable, focusable row (live list and usage table). -->
    <Style x:Key="HoverRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowBg}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
